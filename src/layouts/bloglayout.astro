---
import '../styles/blog.css'
import '../styles/markdown.css'
const { frontmatter = {} } = Astro.props;
const showBackBtn = frontmatter.backbottom || false;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <link rel="icon" type="image/svg+xml" href="/icoo.svg" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARBHOUSE</title>
    
</head>
<body>
    <!-- 顶部导航 -->
    <header>
      <!--   <div class="container nav">
            <a class="logo">我的博客</a>
           <div class="nav-menu">
                <a href="#">首页</a>
                <a href="#">关于我</a>
                <a href="#">文章</a>
                <a href="#">留言</a>
            </div>
        </div>  -->
    </header>

    <div class="container">
        <!-- 主体布局：左侧边栏 + 右侧内容 -->
        <div class="main-wrapper">
            <!-- 左侧边栏：博主信息 -->
            <div class="sidebar">
                <img src="/res/avat2.jpg" alt="avator" class="avatar">
                <h2>ArByron</h2>
                <p class="profile-desc">swinging little boat</p>
                <div class="social-card">
                <h3>Social</h3>
                <ul>
                    <li><a href="https://space.bilibili.com/603087823">Bilibili</a></li>
                    <li><a href="https://x.com/3s2p6">X (Twitter)</a></li>
                    <li><a href="https://www.youtube.com/@user2135ATZ">YouTube</a></li>
                    <li><a href="https://github.com/ASasBRY">GitHub</a></li>
                </ul>
            </div>
            </div>

            <!-- 右侧主体 -->
            <div class="main-content">
                <!-- 博客分类选项卡 -->
                <div class="tab-container">
                    <div class="tab-header">
                        <button class="tab-btn active" data-tab="tech">小径</button>
                        <button class="tab-btn" data-tab="life">密林</button>
                    </div>
                    {showBackBtn &&
                    <div class="back-bar">
                    <!-- 左侧的返回按钮，包含一个 SVG 箭头 -->
                        <button id="go-back-btn" class="back-button" aria-label="返回上一页">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="19" y1="12" x2="5" y2="12"></line>
                                <polyline points="12 19 5 12 12 5"></polyline>
                            </svg>
                            <span>返回</span>
                        </button>
                    </div>}

                    <slot name="home" />

                    <article class="markdown-content">
                        <slot />
                    </article>

                </div>
            </div>
        </div>
    </div>

    <!-- 底部 -->
    <!-- <footer>
        <p>© 2025 我的个人博客 版权所有</p>
    </footer>-->

    <!-- 选项卡切换JS -->
    <script>
        const tabBtns = document.querySelectorAll('.tab-btn');
        const tabContents = document.querySelectorAll('.tab-content');

        tabBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                tabBtns.forEach(b => b.classList.remove('active'));
                tabContents.forEach(c => c.classList.remove('active'));
                btn.classList.add('active');
                const tabId = btn.getAttribute('data-tab');
                document.getElementById(tabId).classList.add('active');
            });
        });
    </script>

    <!--返回组件js -->
    <script>
  // Astro 会自动处理这个 script，并在客户端运行
  const backBtn = document.getElementById('go-back-btn');
  
  if (backBtn) {
    backBtn.addEventListener('click', () => {
      // 执行浏览器返回上一页的操作
      window.history.back();
    });
  }
</script>
</body>
</html>