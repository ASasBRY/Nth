---
import '../styles/blog.css'
import Layout from '../layouts/bloglayout.astro'
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <link rel="icon" type="image/svg+xml" href="/icoo.svg" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARBHOUSE</title>
    
</head>

<Layout>
    <div slot="home">
                    <!-- 技术文章分类 -->
                    <div class="tab-content active" id="tech">
                        <div class="blog-list">
                            <div class="blog-card">
                                <img src="/res/对立.jpg" alt="博客封面" class="blog-img">
                                <div class="blog-info">
                                    <a href="/posts/p1" class="blog-title">这里还没有东西！</a>
                                    <p class="blog-desc">网站搭好了！但是还没整理好要写的东西<br>这里大概会写一些正式的东西，密林是随意一些的（？</p>
                                    <div class="blog-meta">2026-05</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 生活随笔分类 -->
                    <div class="tab-content" id="life">
                        <div class="blog-list">
                            
                            
                        </div>
                    </div>
    </div>

</Layout>